# Copy to .env and change what you need. No secrets are required.
OCR_HOST=127.0.0.1
OCR_PORT=8090
# OpenThai 2.1 weights + v2.2.0 runtime; changing these requires reinstall/rebuild.
OCR_MODEL_ID=iapp/OpenThai2.1-OCR-Markdown-20261118
OCR_MODEL_REVISION=c974dc7d18a4511a21988f4a1d12fad07ac16625
# auto | mps | cpu | cuda
OCR_DEVICE=auto
# true = load the model in the background when the server starts
OCR_PRELOAD=true
# true = never touch the network; use the Hugging Face cache only
OCR_LOCAL_FILES_ONLY=false
OCR_MAX_FILE_MB=50
OCR_MAX_PAGES=20
OCR_PDF_DPI=200
OCR_MAX_NEW_TOKENS=8744
# Where Hugging Face keeps the weights (default ~/.cache/huggingface)
# HF_HOME=/Users/ninetea/.cache/huggingface

# Docker Compose publishes on this host address (OCR_HOST is for native Python).
# Use 0.0.0.0 only to expose to a trusted LAN; no authentication is included.
OCR_BIND_ADDRESS=127.0.0.1
# Optional path to built React files for native Python (Docker sets this itself).
# OCR_FRONTEND_DIR=frontend/dist
